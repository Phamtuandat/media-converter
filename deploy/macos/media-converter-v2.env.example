# Copy to ~/Library/Application Support/media-converter-v2/config/media-converter-v2.env.
# Keep this file mode 600. The token value is intentionally not supplied here.
LISTEN_ADDR=100.94.97.52:8080
MEDIA_SERVICE_TOKEN=replace-with-the-existing-media-service-token
MEDIA_OUTPUT_MODE=webdav
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/bin/ffprobe
MAGICK_PATH=/opt/homebrew/bin/magick

ARTIFACT_INPUT_ROOT="/Users/REPLACE_ME/Library/Application Support/media-converter-v2/staging"
ARTIFACT_OUTPUT_ROOT="/Users/REPLACE_ME/Library/Application Support/media-converter-v2/mnt/media-converter-v2/artifacts"
LEGACY_ARTIFACT_ROOT="/Users/REPLACE_ME/path/to/legacy/local/artifacts"
JOB_STATE_ROOT="/Users/REPLACE_ME/Library/Application Support/media-converter-v2/state"
CACHE_ROOT="/Users/REPLACE_ME/Library/Application Support/media-converter-v2/cache"
WORK_ROOT="/Users/REPLACE_ME/Library/Application Support/media-converter-v2/work"

PUBLIC_BASE_URL=http://100.94.97.52:8080
WEBDAV_PUBLIC_BASE_URL=http://100.x.y.z:8083/media-converter-v2/artifacts
WEBDAV_MOUNT_URL=http://100.x.y.z:8083/media-converter-v2

POLICY_VERSION=media-v1.1
PROCESSOR_VERSION=2.0.0
