[Unit]
Description=Media Converter (WebDAV output instance)
After=network-online.target rclone-webdav.service caddy-webdav.service
Wants=network-online.target
RequiresMountsFor=/mnt/media-webdav

[Service]
Type=simple
User=media-converter
Group=media-converter
EnvironmentFile=/etc/media-converter/media-converter-webdav.env
ExecStartPre=/usr/bin/mountpoint -q /mnt/media-webdav
ExecStart=/opt/media-converter/media-converter serve
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/media-converter-webdav /mnt/media-webdav

[Install]
WantedBy=multi-user.target
