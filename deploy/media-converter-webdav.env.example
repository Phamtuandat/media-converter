# Copy to /etc/media-converter/media-converter-webdav.env and fill in secrets.
LISTEN_ADDR=100.x.y.z:8081
MEDIA_SERVICE_TOKEN=replace-with-a-separate-token
MEDIA_OUTPUT_MODE=webdav

ARTIFACT_INPUT_ROOT=/var/lib/media-converter-webdav/staging
ARTIFACT_OUTPUT_ROOT=/mnt/media-webdav/media-converter-v2/artifacts
JOB_STATE_ROOT=/var/lib/media-converter-webdav/state
CACHE_ROOT=/var/lib/media-converter-webdav/cache
WORK_ROOT=/var/lib/media-converter-webdav/work

PUBLIC_BASE_URL=http://100.x.y.z:8081
WEBDAV_PUBLIC_BASE_URL=https://files.example.test/media-converter-v2/artifacts

# Keep the same processing policy/limits as the legacy instance unless the
# separate WebDAV instance is intentionally being tuned independently.
POLICY_VERSION=media-v1.1
