# Separate writable WebDAV gateway for the Mac v2 mount. Do not reuse the
# existing rclone-webdav.service or caddy-webdav.service configuration.
WEBDAV_ROOT=/srv/media-converter-mac-v2
WEBDAV_ADDR=100.x.y.z:8083
# Optional Basic auth. Leave both empty for Tailnet-only access so the direct
# URLs returned to Hermes work without putting credentials in the URL.
WEBDAV_USER=
WEBDAV_PASS=
